{
  "description": "Updates JSON content files in S3 (products, projects, services). Admin only.",
  "architecture": "arm64",
  "runtime": "provided.al2023",
  "timeoutSeconds": 30,
  "memoryMB": 256,

  "envVars": {
    "CONTENT_BUCKET": { "fromStack": "bucketName" },
    "S3_BUCKET_REGION": { "fromStack": "region" },
    "COGNITO_USER_POOL_ID": { "fromStack": "userPoolId" },
    "RUST_LOG": "info"
  },

  "s3Access": {
    "content": ["put"],
    "media": ["put"]
  },

  "apiGateway": {
    "path": "update-content",
    "methods": ["POST", "OPTIONS"],
    "cognitoAuthorizer": true
  }
}
